# OpenAI is optional. Add it when you want LLM-generated reasoning on top of the deterministic scoring engine.
OPENAI_API_KEY=

# Optional live financial data provider. Use one of these names for your market-data key.
FMP_API_KEY=your_key_here
FINANCIAL_DATA_API_KEY=your_key_here

# Keep false/empty for FMP free plan. Set true only if your FMP plan includes ratios, statements, historical prices, and stock news.
FMP_FULL_FINANCIALS=false

# Optional future news provider key.
NEWS_API_KEY=

